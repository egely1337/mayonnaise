[Desktop Entry]
Type=Application
Name=Mayo Photos
GenericName=Image Viewer
Comment=Browse and view your pictures
Exec=photos %F
Icon=io.github.egely1337.Mayonnaise.Photos
Terminal=false
StartupNotify=true
Categories=Graphics;Viewer;Photography;
Keywords=pictures;images;gallery;viewer;
MimeType=image/jpeg;image/png;image/gif;image/bmp;image/x-tga;image/x-portable-pixmap;
