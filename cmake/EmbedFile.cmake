# Script mode: cmake -DINPUT=... -DOUTPUT=... -DIDENT=... -P EmbedFile.cmake
file(READ ${INPUT} hex HEX)
string(LENGTH "${hex}" hex_len)
math(EXPR size "${hex_len} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
# Break into lines so compilers and editors stay happy with huge files.
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")
file(WRITE ${OUTPUT}
"// Generated by cmake/EmbedFile.cmake from ${INPUT}. Do not edit.
#include <cstddef>
#include <span>
namespace mayo::embedded {
alignas(16) static const unsigned char k_${IDENT}[${size} + 1] = {
${bytes}0x00};
extern const std::span<const unsigned char> ${IDENT};
const std::span<const unsigned char> ${IDENT}{k_${IDENT}, ${size}};
}  // namespace mayo::embedded
")
